# Neon Database Configuration
VITE_NEON_DATABASE_URL=your_neon_connection_string_here

# Example value (replace with your actual Neon connection string):
# VITE_NEON_DATABASE_URL=postgresql://username:password@ep-xyz.us-east-1.neon.tech/dbname?sslmode=require

# Instructions:
# 1. Go to https://neon.tech/
# 2. Create a new project or use existing one
# 3. Go to Dashboard → Connection Details
# 4. Copy your connection string
# 5. Create a .env file and add your actual connection string
# 6. For Netlify deployment, also set both:
#    - NEON_DATABASE_URL (for serverless functions)
#    - VITE_NEON_DATABASE_URL (for frontend)
